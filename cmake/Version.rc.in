#include <winres.h>

101 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/cmake/StartupCompatibility.manifest"

102 DIALOGEX 0, 0, 330, 178
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MCM Bridge - Incompatible mod"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 200, 12, 12, 306, 112
    CONTROL "Click here to open MCMMemory on Nexus Mods", 202, "Static", SS_NOTIFY | WS_CHILD | WS_VISIBLE, 12, 129, 306, 14
    DEFPUSHBUTTON "Exit", 100, 174, 153, 68, 16
    PUSHBUTTON "Ignore", 101, 250, 153, 68, 16
END

1 VERSIONINFO
	FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
	PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
	FILEFLAGSMASK 0x17L
#ifdef _DEBUG
	FILEFLAGS 0x1L
#else
	FILEFLAGS 0x0L
#endif
	FILEOS 0x4L
	FILETYPE 0x1L
	FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "@PROJECT_NAME@"
			VALUE "FileVersion", "@PROJECT_VERSION@.0"
			VALUE "InternalName", "@PROJECT_NAME@"
			VALUE "LegalCopyright", "GNU General Public License v3.0"
			VALUE "ProductName", "@PROJECT_NAME@"
			VALUE "ProductVersion", "@PROJECT_VERSION@.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
